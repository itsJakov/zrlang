start: (func_decl | class_decl)*

class_decl: "class" CNAME [":" CNAME] "{" class_body "}"
class_body: class_member*
?class_member: class_field | func_decl
class_field: "var" CNAME ":" CNAME _END

func_decl: "func" CNAME "(" func_params ")" [func_return] block
func_params: [func_param ("," func_param)*]
func_param: CNAME ":" CNAME
func_return: "->" CNAME

block: "{" statement* "}"
?statement: return_stmt | var_stmt | expr_stmt | assign_stmt | if_stmt
return_stmt: "return" [expr] _END
var_stmt: "var" CNAME ["=" expr] _END
expr_stmt: expr _END
assign_stmt: lvalue "=" expr _END
if_stmt: "if" expr block ["else" block]

// Expressions (lowest to highest precedence)
?expr: logical_or

?logical_or: logical_and
    | logical_or OR logical_and -> binary_expr

?logical_and: equality
    | logical_and AND equality -> binary_expr

?equality: relational
    | equality EQ relational -> binary_expr
    | equality NEQ relational -> binary_expr

?relational: additive
    | relational LT additive -> binary_expr
    | relational LTE additive -> binary_expr
    | relational GT additive -> binary_expr
    | relational GTE additive -> binary_expr

?additive: multiplicative
    | additive ADD multiplicative -> binary_expr
    | additive SUB multiplicative -> binary_expr

?multiplicative: unary
    | multiplicative MUL unary -> binary_expr
    | multiplicative DIV unary -> binary_expr
    | multiplicative MOD unary -> binary_expr

?unary: postfix
    | NOT unary -> unary_expr
    | SUB unary -> unary_expr
    | ADD unary -> unary_expr

?postfix: primary
    | member_expr
    | call_expr

?primary: bool_expr
    | int_expr
    | string_expr
    | symbol_expr
    | alloc_expr
    | "(" expr ")"

?lvalue: symbol_expr
    | member_expr

bool_expr: TRUE | FALSE
int_expr: SIGNED_NUMBER
string_expr: ESCAPED_STRING
symbol_expr: CNAME
member_expr: postfix "." CNAME
call_expr: postfix "(" call_args ")"
alloc_expr: "new" CNAME

call_args: [expr ("," expr)*]

OR: "||"
AND: "&&"
EQ: "=="
NEQ: "!="
LT: "<"
LTE: "<="
GT: ">"
GTE: ">="
ADD: "+"
SUB: "-"
MUL: "*"
DIV: "/"
MOD: "%"
NOT: "!"

TRUE: "true"
FALSE: "false"

_END: WS_INLINE? (NEWLINE | ";")

%import common.WS
%import common.WS_INLINE
%import common.NEWLINE
%import common.CNAME
%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING

%ignore WS